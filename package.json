{
  "name": "heartos-proposal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "build:pages": "VITE_BASE_PATH=/Propose/ vite build && cp dist/index.html dist/404.html",
    "deploy": "npm run build:pages && gh-pages -d dist",
    "preview": "vite preview --port 3000",
    "format": "prettier --write src index.html vite.config.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3"
  }
}
